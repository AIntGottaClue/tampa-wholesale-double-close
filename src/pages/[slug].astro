---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import { cities, brand, domain } from '../data/cities';
import { getFeeTerms, renderFees } from '../data/feeTerms';

const city = cities.find((c) => c.slug === Astro.params.slug);
if (!city) return new Response('Not found', { status: 404 });

const feeTerms = await getFeeTerms();
const r = (s: string) => renderFees(s, feeTerms);

const businessId = `https://${domain}/#business`;
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "FinancialService",
    "@id": businessId,
    "name": brand,
    "url": `https://${domain}/`,
    "areaServed": cities.map((c) => ({ "@type": "City", "name": c.name, "containedInPlace": { "@type": "State", "name": c.stateName } })),
    "description": "Transactional double close funding for real estate wholesalers across the Tampa Bay metro area."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Wholesale double close transactional funding",
    "provider": { "@id": businessId },
    "areaServed": { "@type": "City", "name": city.name, "containedInPlace": { "@type": "State", "name": city.stateName } }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": city.faqs.map((f) => ({
      "@type": "Question",
      "name": r(f.q),
      "acceptedAnswer": { "@type": "Answer", "text": r(f.a) }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://${domain}/` },
      { "@type": "ListItem", "position": 2, "name": `${city.name}, ${city.state}`, "item": `https://${domain}/${city.slug}/` }
    ]
  }
];
---
<Base title={city.title} description={r(city.description)} path={`/${city.slug}/`} jsonld={jsonld}>
  <Header base={`/${city.slug}`} />
  <main>
    <CityContent
      h1Bottom={city.h1Bottom}
      hero={city.hero}
      localNoteTitle={city.localNoteTitle}
      localNote={city.localNote}
      whyHeading={city.whyHeading}
      why={city.why}
      steps={city.steps}
      faqs={city.faqs}
      formName={city.formName}
      cityName={city.name}
      stateAbbr={city.state}
      summaryFees={city.summaryFees}
      summarySteps={city.summarySteps}
      scenario={city.scenario}
    />
  </main>
  <Footer />
</Base>
