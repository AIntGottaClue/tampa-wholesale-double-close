---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import { home } from '../data/metro';
import { brand, domain, cities } from '../data/cities';
import { getFeeTerms, renderFees } from '../data/feeTerms';

const feeTerms = await getFeeTerms();
const r = (s: string) => renderFees(s, feeTerms);

const businessId = `https://${domain}/#business`;
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": brand,
    "url": `https://${domain}/`
  },
  {
    "@context": "https://schema.org",
    "@type": "FinancialService",
    "@id": businessId,
    "name": brand,
    "url": `https://${domain}/`,
    "areaServed": cities.map((c) => ({ "@type": "City", "name": c.name, "containedInPlace": { "@type": "State", "name": c.stateName } })),
    "description": "Transactional double close funding for real estate wholesalers across the Tampa Bay metro area."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Wholesale double close transactional funding",
    "provider": { "@id": businessId },
    "areaServed": cities.map((c) => ({ "@type": "City", "name": c.name, "containedInPlace": { "@type": "State", "name": c.stateName } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": home.faqs.map((f) => ({
      "@type": "Question",
      "name": r(f.q),
      "acceptedAnswer": { "@type": "Answer", "text": r(f.a) }
    }))
  }
];
---
<Base title={home.title} description={r(home.description)} path="/" jsonld={jsonld}>
  <Header base="" />
  <main>
    <CityContent
      h1Bottom={home.h1Bottom}
      hero={home.hero}
      localNoteTitle={home.localNoteTitle}
      localNote={home.localNote}
      whyHeading={home.whyHeading}
      why={home.why}
      steps={home.steps}
      faqs={home.faqs}
      formName={home.formName}
      cityName="Tampa Metro"
      stateAbbr="FL"
      showCityGrid={true}
    />
  </main>
  <Footer />
</Base>
